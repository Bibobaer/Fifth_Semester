#include <windows.h>


#define IDM_OPEN            201
#define IDM_OPEN2           202
#define IDM_SAVE            203
#define IDM_INVERT          204
#define IDM_GRAYSTYLE       205

#define IDM_LESS_LIGHT      206
#define IDM_MORE_LIGHT      207 
#define IDM_BWSTYLE         208
#define IDM_MIRROR_V        209
#define IDM_MIRROR_H        210
#define IDM_ROTATE_LEFT     211
#define IDM_ROTATE_RIGHT    212

MainIcon    ICON    "icon.ico"

Bitmap1     BITMAP  "bitmap.bmp"


MainMenu    MENU {
	POPUP "&Ё"
		{
		MENUITEM "&Открыть\tCtrl+o", IDM_OPEN
        MENUITEM "Открыть из &ресурсов", IDM_OPEN2
        MENUITEM "&Сохранить\tCtrl+s", IDM_SAVE
        MENUITEM "&Преобразовать\tCtrl+i", IDM_INVERT
        MENUITEM "&Оттенки серого\tCtrl+g", IDM_GRAYSTYLE
        MENUITEM "&Уменьшить яркость\tCtrl+z", IDM_LESS_LIGHT
        MENUITEM "&Увеличить яркость\tCtrl+x", IDM_MORE_LIGHT
        MENUITEM "&Сделать черно-белой\tCtrl+a", IDM_BWSTYLE
        MENUITEM "&Отзеркалить изображение по вертикали\tCtrl+n", IDM_MIRROR_V
        MENUITEM "&Отзеркалить изображение по горизонтали\tCtrl+m", IDM_MIRROR_H
        MENUITEM "&Повернуть на 90 градусов влево\tCtrl+l", IDM_ROTATE_LEFT
        MENUITEM "&Повернуть на 90 градусов вправо\tCtrl+r", IDM_ROTATE_RIGHT
		}
	}

Accel   ACCELERATORS {
	"^o", IDM_OPEN
    "^s", IDM_SAVE
    "^i", IDM_INVERT
    "^g", IDM_GRAYSTYLE
    "^z", IDM_LESS_LIGHT
    "^x", IDM_MORE_LIGHT
    "^a", IDM_BWSTYLE
    "^n", IDM_MIRROR_V
    "^m", IDM_MIRROR_H
    "^l", IDM_ROTATE_LEFT
    "^r", IDM_ROTATE_RIGHT
}
